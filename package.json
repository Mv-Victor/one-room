{
  "name": "one-room",
  "version": "0.1.0",
  "description": "Local work timeline for macOS",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "main": "out/main/app.js",
  "engines": { "node": ">=22.22.2 <23" },
  "scripts": {
    "workflow:prepare": "node scripts/prepare-workflow-runtime.mjs",
    "dev": "electron-vite dev --host 127.0.0.1",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "native:build": "node scripts/native-build.mjs",
    "native:smoke": "node scripts/native-smoke.mjs",
    "verify:upstream": "node scripts/verify-upstream.mjs",
    "test:unit": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run",
    "test:integration": "npm run build && ELECTRON_RUN_AS_NODE=1 electron out/main/smoke.js",
    "benchmark:navigation": "node scripts/benchmark-navigation.mjs",
    "benchmark:renderer": "node scripts/benchmark-renderer.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run test:integration",
    "package:mac": "npm run native:build && npm run build && electron-builder --mac --arm64 --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "diff": "8.0.4",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.0",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "42.11.14",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
